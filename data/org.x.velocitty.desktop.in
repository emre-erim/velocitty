[Desktop Entry]
Name=Velocitty
GenericName=Terminal
Comment=Terminal with splits, themes and an SSH address book (Emre Edition)
Exec=velocitty
Icon=org.x.velocitty
Terminal=false
Type=Application
Categories=System;TerminalEmulator;
Keywords=velocitty;terminal;command;prompt;shell;console;ssh;
StartupWMClass=org.x.velocitty
StartupNotify=true
X-ExecArg=--
X-TerminalArgDir=--working-directory
Actions=new-window;new-tab;

[Desktop Action new-window]
Name=New Window
Exec=velocitty --new-window

[Desktop Action new-tab]
Name=New Tab
Exec=velocitty --tab
